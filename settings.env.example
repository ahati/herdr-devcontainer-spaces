# Copy to $CONFIG_DIR/settings.env and edit.
# Find the config dir with: herdr plugin config-dir devcontainer-spaces

# Container engine: auto (default; tries docker then podman) | docker | podman
# Works with rootless and rootful engines of both.
ENGINE=auto

# Create a Herdr space automatically for every discovered devcontainer (startup + rescan).
AUTO_CREATE_SPACES=1

# Run `devcontainer up` for stopped containers during rescan.
# 0 (default): stopped containers are skipped — start them yourself or rescan after.
# 1: rescan will start them (first-time image builds can take a long time).
AUTO_START_CONTAINERS=0

# Space-separated agent kinds to probe for inside containers.
# Probed-present kinds get: a dedicated agent pane (first one) + watcher detection.
# AGENTS="claude codex gemini cursor opencode copilot agy"
AGENTS="claude codex gemini cursor opencode copilot agy"

# Label of the devcontainer tab created inside each space.
TAB_LABEL=devcontainer

# Watcher poll interval in seconds (agent screen classification cadence).
POLL_SECS=3
